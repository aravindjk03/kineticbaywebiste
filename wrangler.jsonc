{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kineticbay",
  "main": "server/worker.js",
  "compatibility_date": "2026-07-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DB_KV",
      "id": "c7c227081bac4504a1dff8db75616aaa"
    }
  ],
  // Non-secret configuration. Secrets (SESSION_SECRET, BREVO_API_KEY) are set with `wrangler secret put`.
  "vars": {
    "MAIL_FROM": "Kineticbay@gmail.com",
    "MAIL_NOTIFY_TO": "Kineticbay@gmail.com",
    "SITE_URL": "https://kineticbay.kineticbay.workers.dev"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
