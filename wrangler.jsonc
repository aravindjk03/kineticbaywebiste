{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kineticbay",
  "main": "server/worker.js",
  "compatibility_date": "2026-07-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DB_KV",
      "id": "8c9c2f9bbe324291af0080466d464d4b"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
